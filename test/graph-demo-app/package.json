{
  "name": "cap-email-graph-demo",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@sap/cds": ">=9",
    "@expertum/cap-email-plugin": "file:../../."
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2"
  },
  "scripts": {
    "start": "cds-tsx watch"
  },
  "cds": {
    "log": {
      "levels": {
        "email": "debug",
        "email:graph": "debug",
        "email-template": "debug"
      }
    },
    "requires": {
      "email": {
        "kind": "graph",
        "destination": "microsoft-graph",
        "email": {
          "from": "<YOUR_M365_SENDER_EMAIL>"
        },
        "credentials": {
          "managed": true
        }
      },
      "microsoft-graph": {
        "kind": "rest"
      },
      "auth": {
        "[development]": {
          "users": {
            "alice": {
              "roles": [
                "admin"
              ],
              "attr": {
                "email": "<YOUR_EMAIL>"
              }
            }
          }
        }
      }
    }
  }
}
