{
  "name": "@expertum/cap-email-plugin",
  "version": "0.1.0",
  "description": "SAP CAP plugin for annotation-driven email automation",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MVansteenhuyse/cap-email.git"
  },
  "main": "cds-plugin.js",
  "files": [
    "cds-plugin.js",
    "index.cds",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "db",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -f cds-plugin.js cds-plugin.js.map && rm -f lib/*.js lib/*.js.map",
    "postpack": "npm run clean",
    "watch": "npx cds watch",
    "test": "npx cds-tsx test --include '(.test.ts)$' -v",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null; npx @cap-js/cds-typer \"*\" --outputDirectory @cds-models && tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@sap/cds": ">=9",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "peerDependenciesMeta": {
    "@sap-cloud-sdk/http-client": {
      "optional": true
    },
    "@sap-cloud-sdk/resilience": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.1",
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/sqlite": "^2.1.3",
    "@sap/cds-dk": "^9.7.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.51.0",
    "prettier": "^3.8.1",
    "tsx": "^4",
    "typescript": "^5"
  },
  "workspaces": [
    "test/graph-demo-app"
  ],
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "kinds": {
        "basic": {
          "impl": "@expertum/cap-email-plugin/lib/basic"
        },
        "graph": {
          "impl": "@expertum/cap-email-plugin/lib/graph-mail"
        }
      },
      "email": {
        "kind": "basic"
      }
    }
  }
}
