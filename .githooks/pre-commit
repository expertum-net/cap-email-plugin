#!/bin/sh

echo "Running pre-commit checks..."

echo "=> oxlint"
npx oxlint || {
  echo "Lint failed. Fix errors before committing."
  exit 1
}

echo "=> TypeScript"
npx tsc --noEmit || {
  echo "Type checking failed. Fix errors before committing."
  exit 1
}

echo "=> Prettier"
npx prettier --check . || {
  echo "Formatting issues found. Run 'npm run format' before committing."
  exit 1
}

echo "=> Tests"
npm test || {
  echo "Tests failed. Fix errors before committing."
  exit 1
}

echo "All pre-commit checks passed."
